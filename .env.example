# Copy to .env (ignored by Git). Do not commit real credentials.
# Literal values only: no shell expansion, commands, or inline comments.
# Relative paths are relative to this project; ~/ is supported.
BLOG_SOURCE_DIR="~/path/to/blog"

# Deploying replaces the named Worker's active deployment.
# Use a separate Worker name for a public preview, not your production Worker.
CF_WORKER_NAME="simple-blog-preview"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
